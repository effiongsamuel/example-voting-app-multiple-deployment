# ---------------------------------------------------------------------------
# Hands the new servers over to Ansible.
#   1. writes ansible/inventory.ini and ansible/vars.generated.yml
#   2. runs ansible-playbook, which installs Docker everywhere and, depending on
#      var.deploy_method:
#        compose  one container per server (postgres, redis, worker, vote, result)
#        k3s      a k3s cluster over the same servers; k8s-specifications/ is
#                 applied with every pod pinned to the server of its tier
#        both     both of the above side by side
# Every server (public or private) is reached through the EC2 Instance Connect
# Endpoint, so the machine running this needs the AWS CLI v2 and credentials
# (GitHub's ubuntu runners already have the CLI) plus ansible:
#     pipx install ansible-core
# ---------------------------------------------------------------------------
resource "random_password" "k3s_token" {
  length  = 40
  special = false
}

locals {
  repo_dir    = abspath("${path.module}/..")
  ansible_dir = "${local.repo_dir}/ansible"
  k8s_dir     = "${local.repo_dir}/k8s-specifications"
  key_path    = pathexpand(var.ssh_private_key_path)

  ansible_files = setunion(
    fileset(local.ansible_dir, "playbook.yml"),
    fileset(local.ansible_dir, "ansible.cfg"),
    fileset(local.ansible_dir, "tasks/**"),
    fileset(local.ansible_dir, "templates/**"),
  )
  k8s_files = fileset(local.k8s_dir, "*.yaml")

  ansible_hash = sha1(join("", [for f in sort(tolist(local.ansible_files)) : filesha1("${local.ansible_dir}/${f}")]))
  k8s_hash     = sha1(join("", [for f in sort(tolist(local.k8s_files)) : filesha1("${local.k8s_dir}/${f}")]))

  # One inventory group per tier. ansible_host is the instance ID: the
  # ProxyCommand below turns it into an SSH tunnel through the endpoint.
  inventory_groups = [
    for tier in keys(local.tiers) : join("\n", concat(
      ["[${tier}]"],
      [
        for k, s in local.servers :
        "${k} ansible_host=${aws_instance.server[k].id} tier=${tier}"
        if s.tier == tier
      ],
      [""],
    ))
  ]

  k3s_agent_names = [for k in keys(local.servers) : k if k != local.k3s_server_key]

  inventory_ini = <<-EOT
    # Generated by Terraform - do not edit.
    ${join("\n", local.inventory_groups)}
    # k3s: one control plane, the other servers are agents.
    [k3s_server]
    ${local.k3s_server_key}

    [k3s_agents]
    ${join("\n", local.k3s_agent_names)}

    [all:vars]
    ansible_user=${var.ssh_user}
    ansible_ssh_private_key_file=${local.key_path}
    ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o IdentitiesOnly=yes -o ProxyCommand="aws ec2-instance-connect open-tunnel --instance-id %h --region ${var.aws_region}"'
  EOT

  ansible_vars_yml = <<-EOT
    # Generated by Terraform - contains a secret, do not commit.
    deploy_method: "${var.deploy_method}"
    aws_region: "${var.aws_region}"
    alb_dns: "${aws_lb.app.dns_name}"
    result_listener_port: ${var.result_listener_port}
    redis_ip: "${aws_instance.server["redis-a"].private_ip}"
    db_ip: "${aws_instance.server["postgres-a"].private_ip}"
    vote_image: "${var.vote_image}"
    result_image: "${var.result_image}"
    worker_image: "${var.worker_image}"
    k3s_token: "${random_password.k3s_token.result}"
    k3s_server_ip: "${aws_instance.server[local.k3s_server_key].private_ip}"
    k3s_vote_nodeport: ${var.k3s_vote_nodeport}
    k3s_result_nodeport: ${var.k3s_result_nodeport}
  EOT
}

resource "local_file" "ansible_inventory" {
  filename = "${local.ansible_dir}/inventory.ini"
  content  = local.inventory_ini
}

resource "local_sensitive_file" "ansible_vars" {
  filename        = "${local.ansible_dir}/vars.generated.yml"
  file_permission = "0600"
  content         = local.ansible_vars_yml
}

resource "terraform_data" "ansible_deploy" {
  count = var.run_ansible ? 1 : 0

  # Re-runs when any server is replaced or an ansible file / manifest / image changes.
  triggers_replace = [
    join(",", [for k in sort(keys(aws_instance.server)) : aws_instance.server[k].id]),
    var.deploy_method,
    var.vote_image,
    var.result_image,
    var.worker_image,
    var.result_listener_port,
    var.k3s_vote_nodeport,
    var.k3s_result_nodeport,
    local.ansible_hash,
    local.k8s_hash,
  ]

  provisioner "local-exec" {
    working_dir = local.ansible_dir
    command     = "timeout 55m ansible-playbook playbook.yml -e @vars.generated.yml"
    environment = {
      ANSIBLE_CONFIG = "${local.ansible_dir}/ansible.cfg"
    }
  }

  depends_on = [
    local_file.ansible_inventory,
    local_sensitive_file.ansible_vars,
    aws_ec2_instance_connect_endpoint.ssh,
    aws_route.private_nat,
    aws_lb_target_group_attachment.route,
    aws_lb_listener.route,
  ]
}
