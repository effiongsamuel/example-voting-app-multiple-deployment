# ---------------------------------------------------------------------------
# Hands the new server over to Ansible.
#   1. writes ansible/inventory.ini and ansible/vars.generated.yml
#   2. runs ansible-playbook, which waits for SSH, installs Docker and deploys
#      the app (Docker Compose and/or k3s, depending on var.deploy_method).
# Needs ansible on the machine running terraform:  pipx install ansible-core
# Layout: terraform/  ansible/  k8s-specifications/  side by side in the repo.
# ---------------------------------------------------------------------------
locals {
  repo_dir    = abspath("${path.module}/..")
  ansible_dir = "${local.repo_dir}/ansible"
  k8s_dir     = "${local.repo_dir}/k8s-specifications"
  key_path    = pathexpand(var.ssh_private_key_path)

  ansible_files = setunion(
    fileset(local.ansible_dir, "playbook.yml"),
    fileset(local.ansible_dir, "ansible.cfg"),
    fileset(local.ansible_dir, "tasks/**"),
    fileset(local.ansible_dir, "templates/**"),
  )
  k8s_files = fileset(local.k8s_dir, "*.yaml")

  ansible_hash = sha1(join("", [for f in sort(tolist(local.ansible_files)) : filesha1("${local.ansible_dir}/${f}")]))
  k8s_hash     = sha1(join("", [for f in sort(tolist(local.k8s_files)) : filesha1("${local.k8s_dir}/${f}")]))

  inventory_ini = <<-EOT
    # Generated by Terraform - do not edit.
    [voting]
    voting-server ansible_host=${aws_eip.voting.public_ip}

    [all:vars]
    ansible_user=${var.ssh_user}
    ansible_ssh_private_key_file=${local.key_path}
    ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o IdentitiesOnly=yes'
  EOT

  ansible_vars_yml = <<-EOT
    # Generated by Terraform - do not commit.
    deploy_method: "${var.deploy_method}"
    public_ip: "${aws_eip.voting.public_ip}"
    private_ip: "${aws_instance.voting_server.private_ip}"
    vote_port: ${var.vote_port}
    result_port: ${var.result_port}
    k3s_vote_nodeport: ${var.k3s_vote_nodeport}
    k3s_result_nodeport: ${var.k3s_result_nodeport}
    vote_image: "${var.vote_image}"
    result_image: "${var.result_image}"
    worker_image: "${var.worker_image}"
  EOT
}

resource "local_file" "ansible_inventory" {
  filename = "${local.ansible_dir}/inventory.ini"
  content  = local.inventory_ini
}

resource "local_file" "ansible_vars" {
  filename = "${local.ansible_dir}/vars.generated.yml"
  content  = local.ansible_vars_yml
}

resource "terraform_data" "ansible_deploy" {
  count = var.run_ansible ? 1 : 0

  # Re-runs when the server is replaced or any app / ansible / manifest file changes.
  triggers_replace = [
    aws_instance.voting_server.id,
    aws_eip.voting.public_ip,
    var.deploy_method,
    var.vote_port,
    var.result_port,
    var.vote_image,
    var.result_image,
    var.worker_image,
    local.ansible_hash,
    local.k8s_hash,
  ]

  provisioner "local-exec" {
    working_dir = local.ansible_dir
    command     = "timeout 30m ansible-playbook playbook.yml -e @vars.generated.yml"
    environment = {
      ANSIBLE_CONFIG = "${local.ansible_dir}/ansible.cfg"
    }
  }

  depends_on = [
    local_file.ansible_inventory,
    local_file.ansible_vars,
    aws_eip_association.voting,
    aws_route_table_association.public,
  ]
}
