# Generated by Ansible - do not edit on the server. Tier: {{ tier }}
# The apps look up the host names "redis" and "db"; extra_hosts points them at
# the right servers in the VPC.
services:
{% if tier == 'postgres' %}
  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped

volumes:
  db-data:
{% elif tier == 'redis' %}
  redis:
    image: redis:alpine
    # Other servers connect over the network, so protected mode must be off.
    # The security group only lets vote and worker reach port 6379.
    command: ["redis-server", "--protected-mode", "no"]
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped
{% elif tier == 'worker' %}
  worker:
    image: {{ worker_image }}
    extra_hosts:
      - "redis:{{ redis_ip }}"
      - "db:{{ db_ip }}"
    restart: unless-stopped
{% elif tier == 'vote' %}
  vote:
    image: {{ vote_image }}
    ports:
      - "80:80"
    extra_hosts:
      - "redis:{{ redis_ip }}"
    restart: unless-stopped
{% elif tier == 'result' %}
  result:
    image: {{ result_image }}
    ports:
      - "80:80"
    extra_hosts:
      - "db:{{ db_ip }}"
    restart: unless-stopped
{% endif %}
