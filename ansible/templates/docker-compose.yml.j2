# Generated by Ansible - do not edit on the server.
services:
  vote:
    image: {{ vote_image }}
    depends_on:
      redis:
        condition: service_healthy
    ports:
      - "{{ vote_port }}:80"
    networks:
      - front-tier
      - back-tier
    restart: unless-stopped

  result:
    image: {{ result_image }}
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "{{ result_port }}:80"
    networks:
      - front-tier
      - back-tier
    restart: unless-stopped

  worker:
    image: {{ worker_image }}
    depends_on:
      redis:
        condition: service_healthy
      db:
        condition: service_healthy
    networks:
      - back-tier
    restart: unless-stopped

  redis:
    image: redis:alpine
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks:
      - back-tier
    restart: unless-stopped

  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks:
      - back-tier
    restart: unless-stopped

volumes:
  db-data:

networks:
  front-tier:
  back-tier:
