# Generated by Ansible. Takes k8s-specifications/ as it is (base/) and pins each
# deployment to the servers whose node label tier=<name> matches:
#   vote, result, worker : 2 replicas, one per server (spread by hostname)
#   db, redis            : 1 replica, on the postgres / redis server
resources:
{% for f in ['db-deployment.yaml', 'db-service.yaml', 'redis-deployment.yaml', 'redis-service.yaml', 'result-deployment.yaml', 'result-service.yaml', 'vote-deployment.yaml', 'vote-service.yaml', 'worker-deployment.yaml'] %}
  - base/{{ f }}
{% endfor %}

patches:
{% for t in ['vote', 'result', 'worker'] %}
  - target:
      kind: Deployment
      name: {{ t }}
    patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: {{ t }}
      spec:
        replicas: 2
        template:
          spec:
            nodeSelector:
              tier: {{ t }}
            topologySpreadConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: DoNotSchedule
                labelSelector:
                  matchLabels:
                    app: {{ t }}
{% endfor %}
{% for pair in [['db', 'postgres'], ['redis', 'redis']] %}
  - target:
      kind: Deployment
      name: {{ pair[0] }}
    patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: {{ pair[0] }}
      spec:
        replicas: 1
        template:
          spec:
            nodeSelector:
              tier: {{ pair[1] }}
{% endfor %}
